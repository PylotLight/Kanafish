{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PylotLight/Kanafish/course/course.schema.json",
  "title": "Kanafish beginner travel-conversation course",
  "type": "object",
  "required": ["schemaVersion", "courseId", "title", "language", "learnerLevel", "durationWeeks", "sessionsPerWeek", "lessonLengthMinutes", "designPrinciples", "lessonArc", "reviewCadence", "learningPath", "kanaPolicy", "weeks"],
  "properties": {
    "schemaVersion": {"type": "string"},
    "courseId": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "title": {"type": "string"},
    "language": {"const": "ja-JP"},
    "learnerLevel": {"type": "string"},
    "durationWeeks": {"const": 12},
    "sessionsPerWeek": {"const": 3},
    "lessonLengthMinutes": {"type": "string"},
    "designPrinciples": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "lessonArc": {"type": "array", "items": {"enum": ["recognize", "supported-response", "adapt", "communicate with less scripting"]}, "minItems": 3},
    "reviewCadence": {"$ref": "#/$defs/reviewCadence"},
    "learningPath": {"type": "array", "items": {"$ref": "#/$defs/learningPhase"}, "minItems": 4, "maxItems": 4},
    "kanaPolicy": {"type": "string"},
    "weeks": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"$ref": "#/$defs/week"}}
  },
  "additionalProperties": false,
  "$defs": {
    "learningPhase": {
      "type": "object",
      "required": ["id", "title", "level", "weeks", "outcome"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "title": {"type": "string", "minLength": 1},
        "level": {"type": "string", "minLength": 1},
        "weeks": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 12}, "minItems": 1},
        "outcome": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "phrase": {
      "type": "object",
      "required": ["ja", "en", "use"],
      "properties": {"ja": {"type": "string"}, "en": {"type": "string"}, "use": {"type": "string"}},
      "additionalProperties": false
    },
    "kanjiCard": {
      "type": "object",
      "required": ["kanji", "reading", "meaning", "whyHere"],
      "properties": {"kanji": {"type": "string"}, "reading": {"type": "string"}, "meaning": {"type": "string"}, "whyHere": {"type": "string"}},
      "additionalProperties": false
    },
    "reviewCadence": {
      "type": "object",
      "required": ["sessionWarmup", "weeklyInterleave", "longerSpacing", "milestoneRevisit", "adaptation"],
      "properties": {
        "sessionWarmup": {"type": "string"},
        "weeklyInterleave": {"type": "string"},
        "longerSpacing": {"type": "string"},
        "milestoneRevisit": {"type": "string"},
        "adaptation": {"type": "string"}
      },
      "additionalProperties": false
    },
    "dialogueLine": {
      "type": "object",
      "required": ["speaker", "ja", "en"],
      "properties": {"speaker": {"type": "string"}, "ja": {"type": "string"}, "en": {"type": "string"}},
      "additionalProperties": false
    },
    "milestone": {
      "type": "object",
      "required": ["id", "title", "task", "evidence"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "task": {"type": "string"},
        "evidence": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "rubric": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "lesson": {
      "type": "object",
      "required": ["id", "title", "stage", "scene", "goal", "dialogue", "listenCheck", "responsePractice", "sayTask", "adaptation", "successChecks"],
      "properties": {
        "id": {"type": "string", "pattern": "^W[0-9]{2}-L[1-3]$"},
        "title": {"type": "string"},
        "stage": {"enum": ["recognize", "supported-response", "adapt"]},
        "scene": {"type": "string"},
        "goal": {"type": "string", "minLength": 1},
        "dialogue": {"type": "array", "items": {"$ref": "#/$defs/dialogueLine"}, "minItems": 2},
        "listenCheck": {
          "type": "object",
          "required": ["question", "choices", "answer"],
          "properties": {"question": {"type": "string"}, "choices": {"type": "array", "items": {"type": "string"}, "minItems": 2}, "meanings": {"type": "array", "items": {"type": "string"}}, "answer": {"type": "integer", "minimum": 0}},
          "additionalProperties": false
        },
        "responsePractice": {
          "type": "object",
          "required": ["prompt", "choices", "answer", "why"],
          "properties": {"prompt": {"type": "string"}, "choices": {"type": "array", "items": {"type": "string"}}, "meanings": {"type": "array", "items": {"type": "string"}}, "answer": {"type": ["integer", "null"], "minimum": 0}, "why": {"type": "string"}},
          "additionalProperties": false
        },
        "sayTask": {"type": "string"},
        "adaptation": {"type": "string"},
        "successChecks": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      },
      "additionalProperties": false
    },
    "week": {
      "type": "object",
      "required": ["week", "title", "canDo", "conversationStage", "phraseBank", "kanaFocus", "kanjiCards", "lessons"],
      "properties": {
        "week": {"type": "integer", "minimum": 1, "maximum": 12},
        "title": {"type": "string"},
        "canDo": {"type": "string"},
        "conversationStage": {"type": "string"},
        "phraseBank": {"type": "array", "items": {"$ref": "#/$defs/phrase"}, "minItems": 1},
        "kanaFocus": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "kanjiCards": {"type": "array", "items": {"$ref": "#/$defs/kanjiCard"}},
        "milestone": {"$ref": "#/$defs/milestone"},
        "lessons": {"type": "array", "items": {"$ref": "#/$defs/lesson"}, "minItems": 3, "maxItems": 3}
      },
      "additionalProperties": false
    }
  }
}
